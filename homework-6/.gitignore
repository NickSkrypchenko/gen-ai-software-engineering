# Dependencies
node_modules/

# Coverage output
coverage/

# Runtime pipeline output (generated by `npm run pipeline`)
# Tracked directories are kept via .gitkeep; generated artifacts are ignored.
shared/input/*
shared/processing/*
shared/output/*
shared/results/*
!shared/**/.gitkeep

# OS / editor
.DS_Store

# .claude/ is ignored repo-wide (root .gitignore), but for homework-6 the
# commands/hooks/settings under it are required, graded deliverables.
!.claude/
!.claude/**
# ...except Claude Code's machine-local settings, which must never be committed.
.claude/settings.local.json
